   "metadata": {},
   "source": [
    "### Phase 3: CLM Fine-Tuning (2x T4 DDP)\n",
    "Uses `torchrun` to utilize both GPUs and the new stability fixes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Launch with Distributed Data Parallel (DDP)\n",
    "!torchrun --nproc_per_node=2 fine_tune_clm.py"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Phase 4: DPO Penalization (Decoupled Generation + 2x T4 DDP)\n",
    "Uses the DiagnosticJudge to penalize AI-like patterns. Generation is done sequentially to prevent DDP timeouts."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "# Step 1: Generate DPO Dataset if not already present\n",
    "if not os.path.exists(\"dpo_dataset.json\"):\n",
    "    print(\"\ud83d\udce6 Dataset not found. Starting generation (this will take a while)... \")\n",
    "    !python generate_dpo_data.py\n",
    "    \n",
    # Push the generated dataset to HuggingFace so you don't lose it if the session resets\n",
    "    print(\"\ud83d\udce4 Pushing dataset to HuggingFace for persistence...\")\n",
    "    try:\n",
    "        from huggingface_hub import HfApi\n",
    "        from datetime import datetime\n",
    "        api = HfApi()\n",
    "        username = api.whoami()[\"name\"]\n",
    "        repo_id = f\"{username}/scholarai-v3-dpo-dataset\"\n",
    "        \n",
    "        api.create_repo(repo_id=repo_id, repo_type=\"dataset\", private=True, exist_ok=True)\n",
    "        timestamp = datetime.utcnow().strftime(\"%Y%m%d_%H%M%S\")\n",
    "        api.upload_file(\n",
    "            path_or_fileobj=\"dpo_dataset.json\",\n",
    "            path_in_repo=f\"backups/{timestamp}_dpo_dataset.json\",\n",
    "            repo_id=repo_id,\n",
    "            repo_type=\"dataset\"\n",
    "        )\n",
    "        print(f\"\u2705 Dataset successfully backed up to https://huggingface.co/datasets/{repo_id}/tree/main/backups\")\n",
    "    except Exception as e:\n",
    "        print(f\"\u26a0\ufe0f HuggingFace backup failed: {e}. Moving on to training...\")\n",
    "\n",
    "else: \n",
    "    print(\"\u2705 Found existing dpo_dataset.json. Skipping generation.\")\n",
    "\n",
    "# Step 2: DPO Training (2x T4 DDP)\n",
    "print(\"\ud83d\ude80 Starting DDP Training...\")\n",
    "!torchrun --nproc_per_node=2 fine_tune_dpo.py"
   ]
  },
  {
   "cell_type": "markdown",
